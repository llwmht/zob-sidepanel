<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      System roots plus ISRG Root X1 (Let's Encrypt). Android 7.0 ships without ISRG Root X1, so sites
      using Let's Encrypt certificates fail there. The certificate is the one published at
      https://letsencrypt.org/certs/isrgrootx1.pem (SHA-256 96:BC:EC:06:...:BD:DF:08:C6).
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
    <!-- Cleartext only to the panel's own loopback server. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
